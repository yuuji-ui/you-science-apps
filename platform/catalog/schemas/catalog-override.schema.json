{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://you-science-apps.example/schemas/catalog-override.schema.json",
  "title": "You Science Apps Catalog Override",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "featured": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "deprecatedMessage": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}