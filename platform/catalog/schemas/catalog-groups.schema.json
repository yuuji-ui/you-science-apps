{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://you-science-apps.example/schemas/catalog-groups.schema.json",
  "title": "You Science Apps Catalog Groups",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupId",
          "title",
          "appIds",
          "sortOrder"
        ],
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "appIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "sortOrder": {
            "type": "integer"
          }
        }
      }
    }
  }
}