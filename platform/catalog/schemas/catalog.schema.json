{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://you-science-apps.example/schemas/catalog.schema.json",
  "title": "You Science Apps Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "apps",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogApp"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogGroup"
      }
    }
  },
  "$defs": {
    "catalogApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "title",
        "version",
        "status",
        "schoolStage",
        "subjects",
        "grades",
        "units",
        "appTypes",
        "learningGoals",
        "useCases",
        "hostedUrl",
        "featured",
        "hidden",
        "sortOrder",
        "updatedOn",
        "portalGroups",
        "audiences",
        "categories",
        "tags",
        "learningDifficulty"
      ],
      "properties": {
        "appId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "schoolStage": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learningGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostedUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "featured": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deprecatedMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedOn": {
          "type": "string",
          "format": "date"
        },
        "portalGroups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "audiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "learningDifficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "catalogGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "title",
        "appIds",
        "sortOrder"
      ],
      "properties": {
        "groupId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "appIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sortOrder": {
          "type": "integer"
        }
      }
    }
  }
}